# Gateway configuration
# Supported providers: mock, openai, openrouter
SAG_PROVIDER=mock

# Persistent gateway client registry.
# PostgreSQL is the default runtime backend; environment is reserved for tests/legacy migration.
SAG_CLIENT_REGISTRY_BACKEND=postgres

# Persistent daily token/cost accounting.
# PostgreSQL is the default runtime backend; memory is reserved for deterministic tests.
SAG_USAGE_LEDGER_BACKEND=postgres

# Distributed request-rate accounting.
# Redis is the default runtime backend; memory is reserved for deterministic tests.
SAG_RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0

# Local PostgreSQL development configuration.
# Change credentials for any non-local environment.
POSTGRES_PASSWORD=sag_dev_password
DATABASE_URL=postgresql://sag:sag_dev_password@127.0.0.1:5432/secure_ai_gateway

# Deployment-wide model ceiling. A model must appear here before any client can use it.
# Comma-separated exact model names.
# Examples: mock-model,openrouter/free
SAG_ALLOWED_MODELS=

# Per-client model grants.
# Format: client_id:model[,client_id:model...]
# Repeat a client ID to grant multiple models.
# Example: local-dev:openrouter/free,service-a:mock-model
SAG_CLIENT_ALLOWED_MODELS=

# Per-client requests-per-minute limits for protected chat requests.
# Format: client_id:requests_per_minute[,client_id:requests_per_minute...]
# Example: local-dev:10,service-a:60
SAG_CLIENT_RATE_LIMITS=

# Per-client UTC-day token and cost budgets.
# Format: client_id:daily_tokens:daily_cost_usd[,client_id:daily_tokens:daily_cost_usd...]
# Use - to disable one dimension.
# Examples: local-dev:50000:1.00,service-a:100000:-
SAG_CLIENT_DAILY_BUDGETS=

# Per-client structured-PII handling.
# Supported actions: redact, deny
# Format: client_id:action[,client_id:action...]
# Example: local-dev:redact,high-security-client:deny
SAG_CLIENT_PII_POLICIES=

# Per-client prompt-injection handling.
# Supported actions: audit, deny, off
# audit records indicators but forwards the request; deny blocks detected attacks.
# off is an explicit opt-out and is different from missing policy, which fails closed.
# Format: client_id:action[,client_id:action...]
# Example: local-dev:audit,high-security-client:deny
SAG_CLIENT_PROMPT_INJECTION_POLICIES=

# OpenAI provider configuration
# Required only when SAG_PROVIDER=openai.
OPENAI_API_KEY=

# Optional. Leave empty to use the provider's standard API base URL.
OPENAI_BASE_URL=

# OpenRouter provider configuration
# Required only when SAG_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Optional. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
