# Gateway configuration
# Supported providers: mock, openai, openrouter
SAG_PROVIDER=mock

# Persistent gateway client registry.
# PostgreSQL is the default runtime backend; environment is reserved for tests/legacy migration.
SAG_CLIENT_REGISTRY_BACKEND=postgres

# Persistent daily token/cost accounting.
# PostgreSQL is the default runtime backend; memory is reserved for deterministic tests.
SAG_USAGE_LEDGER_BACKEND=postgres

# Distributed request-rate accounting.
# Redis is the default runtime backend; memory is reserved for deterministic tests.
SAG_RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0

# Local semantic/contextual PII analysis.
# spacy is currently the only supported backend and is the default.
SAG_SEMANTIC_PII_BACKEND=spacy

# Execution-time tool authorization.
# Required only when a model is allowed to return executable tool calls.
# The policy file is non-secret; copy/customize the tracked example for real tools.
SAG_TOOL_EXECUTION_POLICY_FILE=config/tool-execution-policies.example.json
# Secret HMAC key used to issue short-lived execution tickets. Use at least 32 random bytes.
SAG_TOOL_EXECUTION_SIGNING_KEY=
# Tickets expire quickly and are consumed once. Maximum supported lifetime is 900 seconds.
SAG_TOOL_EXECUTION_TTL_SECONDS=120
# redis is the runtime default; memory is reserved for deterministic tests.
SAG_TOOL_EXECUTION_REPLAY_BACKEND=redis

# OpenTelemetry tracing. Prometheus /metrics is always available for internal scraping.
# Compose defaults tracing to true and sends OTLP/HTTP spans to its local collector.
# Host-run development can enable this after starting an OTLP collector on port 4318.
SAG_OTEL_ENABLED=false
OTEL_SERVICE_NAME=secure-ai-gateway
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Local PostgreSQL development configuration.
# Change credentials for any non-local environment.
POSTGRES_PASSWORD=sag_dev_password
DATABASE_URL=postgresql://sag:sag_dev_password@127.0.0.1:5432/secure_ai_gateway

# Deployment-wide model ceiling. A model must appear here before any client profile can use it.
# Comma-separated exact model names.
# Examples: mock-model,openrouter/free
SAG_ALLOWED_MODELS=

# Unified non-secret per-client security policy registry.
# Copy config/security-policies.example.json to this ignored local path and validate it.
SAG_SECURITY_POLICY_FILE=config/security-policies.json

# OpenAI provider configuration
# Required only when SAG_PROVIDER=openai.
OPENAI_API_KEY=

# Optional. Leave empty to use the provider's standard API base URL.
OPENAI_BASE_URL=

# OpenRouter provider configuration
# Required only when SAG_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Optional. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
