# Gateway configuration
SAG_PROVIDER=<mock|openai>
SAG_API_KEY=<gateway-api-key>
SAG_ALLOWED_MODELS=<comma-separated-model-names>

# Provider-specific configuration
# Required when SAG_PROVIDER=openai
OPENAI_API_KEY=<provider-api-key>

# Optional. Defaults to the provider's standard API base URL.
OPENAI_BASE_URL=<provider-base-url>
