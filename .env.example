# Gateway configuration
# Supported providers: mock, openai
SAG_PROVIDER=mock

# Set a private bearer key for clients calling the gateway.
SAG_API_KEY=

# Comma-separated exact model names allowed by gateway policy.
# Example for the mock provider: mock-model
SAG_ALLOWED_MODELS=

# OpenAI provider configuration
# Required only when SAG_PROVIDER=openai.
OPENAI_API_KEY=

# Optional. Leave empty to use the provider's standard API base URL.
OPENAI_BASE_URL=
